---
const path = Astro.url.pathname;
const current = (href: string) =>
  path === href || path.startsWith(`${href}/`) || (href === "/blog" && path.startsWith("/post/"));
---
<div class="shell">
  <aside class="rail">
    <a class="brand" href="/">Rodrigo<br />Villalba</a>
    <div class="tray">
      <nav aria-label="Principal">
        <a class="key" href="/">Home</a>
        <a class="key" href="/about" aria-current={current("/about") ? "page" : undefined}>About</a>
        <a class="key" href="/blog" aria-current={current("/blog") ? "page" : undefined}>Blog</a>
      </nav>
      <div class="ext" aria-label="Perfiles">
        <a class="key" href="https://github.com/rodrigojv" rel="noopener">GitHub</a>
        <a class="key" href="https://www.linkedin.com/in/rojv/" rel="noopener">LinkedIn</a>
      </div>
    </div>
  </aside>
  <div class="paper"><slot /></div>
</div>
