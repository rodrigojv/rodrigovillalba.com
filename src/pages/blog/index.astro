---
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { getPostsByDate } from "../../utils/posts";

const posts = await getPostsByDate();
const own = posts.filter((p) => !p.data.guest_post_url);
const guest = posts.filter((p) => p.data.guest_post_url);
---
<Base title="Blog · Rodrigo Villalba" description="Words and thoughts about software development, productivity and other wholesome topics">
  <main>
    <h1>Blog</h1>
    <p>Words and thoughts about software development, productivity and other wholesome topics</p>
    <PostList posts={own} />
    {guest.length > 0 && (
      <section>
        <h2>Guest posts</h2>
        <PostList posts={guest} />
      </section>
    )}
  </main>
</Base>
